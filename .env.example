# ==========================================
# LABS STDIO - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env or paste into Vercel Dashboard
# ==========================================

# 1. Database & Security
DATABASE_URL="file:./dev.db" # Or postgresql://user:pass@host:5432/db for PostgreSQL
JWT_SECRET="generate-a-strong-32-character-secret-key-here"

# 2. Application & OAuth
NEXT_PUBLIC_APP_URL="https://labsstdio.com"
ADMIN_EMAILS="admin@labsstdio.com"
ADMIN_SECRET_PREFIX="LABSADMIN"

GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# 3. Automation Notifications & Bots (Optional)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-channel-or-group-id"
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-url"

# 4. Email Dispatcher (Resend)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Labs Stdio <notifications@labsstdio.com>"
AGENCY_NOTIFICATION_EMAIL="admin@labsstdio.com"

# 5. Dual Payment Gateways (Stripe & Midtrans)
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
MIDTRANS_SERVER_KEY="Mid-server-your-server-key"
MIDTRANS_CLIENT_KEY="Mid-client-your-client-key"
MIDTRANS_IS_PRODUCTION="false"

# 6. Distributed Cloud Caching & Global Rate Limiting (Upstash Redis - Optional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
